<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Lindungi file sensitif agar tidak bisa diakses via browser
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml) - [F,L,NC]
    RewriteRule (^|/)\.(?!well-known) - [F]

    # 2. Matikan browsing direktori
    Options -Indexes

    # 3. Handle Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # 4. Arahkan semua request ke folder public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
